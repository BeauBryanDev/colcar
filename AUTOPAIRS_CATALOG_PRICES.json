{
  "_schema_notes": {
    "description": "Catalogo de precios de referencia para Beau Auto-Repairs (empresa ficticia). Cada entrada es un nodo del PricingTrie, indexado por pieza -> tipo_defecto -> severidad.",
    "pieza_specific_vs_generic": "Las entradas con 'is_generic_fallback': true no representan una pieza real, son el nodo de respaldo de una categoria completa (ej. 'generic:body_panel' cubre trunk, tailgate, back_left_door, etc. cuando no hay entrada exacta).",
    "currency": "COP",
    "fields_to_fill": [
      "labor_hours",
      "labor_cost_cop",
      "materials_cost_cop",
      "parts_cost_cop",
      "total_cost_cop"
    ],
    "severity_floor_rule": "glass_shatter y lamp_broken siempre son 'grave' por regla de negocio (definida en severity_rules.py), por eso no tienen entradas leve/moderado.",
    "pricing_methodology": "Valores calibrados para un taller independiente de nivel medio en Colombia, usando referencias publicadas de pintura/latonería y precios observados de repuestos como ancla. Cuando no existe una tarifa pública suficientemente específica, se usa una estimación sintética conservadora. Los valores son orientativos y no constituyen una cotización comercial.",
    "labor_rate_reference_cop_per_hour": 60000,
    "last_calibrated": "2026-08",
    "placeholder_prices": "Las entradas con 'is_placeholder_price': true tienen valores provisionales (tire_flat, Puncture, Pitting). Reemplazar por precios reales antes de produccion."
  },
